# --- Asterisk ARI ---
ARI_URL=http://localhost:8088/ari
ARI_WS_URL=ws://localhost:8088/ari/events
ARI_USER=mcp_user
ARI_PASSWORD=mcp_secret_password
ARI_APP=asterisk-vocal-ai

# --- Asterisk AMI ---
AMI_HOST=127.0.0.1
AMI_PORT=5038
AMI_USER=mcp_ami_user
AMI_PASSWORD=ami_secret_password

# --- CDR MySQL ---
CDR_DB_HOST=localhost
CDR_DB_USER=asterisk
CDR_DB_PASSWORD=asterisk
CDR_DB_NAME=asterisk

# --- Keycloak ---
KEYCLOAK_URL=http://localhost:8090
KEYCLOAK_REALM=mcp-asterisk
KEYCLOAK_CLIENT_ID=mcp-agent

# --- Ollama ---
OLLAMA_MODEL=qwen2.5:3b

# --- S2S ---
UDP_IP=127.0.0.1
UDP_PORT=5088
PIPER_MODEL=./models/fr_FR-siwis-medium.onnx
WHISPER_MODEL=small

# --- Rôle par défaut (dev) ---
MCP_ROLE=admin
